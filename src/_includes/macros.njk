{#- Reusable view helpers. Import with: {% import "macros.njk" as ui %} -#}

{%- macro sect(en, tr, extra="", id="") -%}
<h2 class="sect"{% if id %} id="{{ id }}"{% endif %}><span aria-hidden="true">[:</span>{% t en, tr %}<span aria-hidden="true">:]</span>{% if extra %} <small>{{ extra | safe }}</small>{% endif %}</h2>
{%- endmacro -%}

{#- Bilingual prose block. If one language is missing, the other is shown in both modes with a notice. -#}
{%- macro bitext(en, tr, cls="prose") -%}
{%- if en and tr -%}
<div class="{{ cls }} l-en" lang="en">{{ en | md | safe }}</div>
<div class="{{ cls }} l-tr" lang="tr">{{ tr | md | safe }}</div>
{%- elif tr -%}
<p class="notice l-en">This page needs translation from <em>Turkish to English</em>.</p>
<div class="{{ cls }}" lang="tr">{{ tr | md | safe }}</div>
{%- elif en -%}
<p class="notice l-tr">Bu sayfanın <em>İngilizceden Türkçeye</em> çevrilmesi gerekiyor.</p>
<div class="{{ cls }}" lang="en">{{ en | md | safe }}</div>
{%- endif -%}
{%- endmacro -%}

{%- macro genres(list) -%}
{%- if list and list.length -%}<span class="genres">{% for g in list %}{{ g }}{% if not loop.last %} <span class="x" aria-hidden="true">⤬</span><span class="sr-only">,</span> {% endif %}{% endfor %}</span>{%- endif -%}
{%- endmacro -%}

{#- Genre names linked to their page under /sound/genres/ (names without a page stay plain text). -#}
{%- macro genreLinks(list, sep=", ") -%}
{%- for n in list or [] %}{% set g = collections.genres | byName(n) %}{% if g %}<a href="{{ g.url }}">{{ g.data.name }}</a>{% else %}{{ n }}{% endif %}{% if not loop.last %}{{ sep | safe }}{% endif %}{% endfor -%}
{%- endmacro -%}

{#- Flavor: free text written by the editors, e.g. "bass ⤬ breaks ⤬ core" or "bass breaks core + punk". -#}
{%- macro flavor(text) -%}
{%- if text and text.length -%}<span class="genres">{{ text | flavorText | safe }}</span>{%- endif -%}
{%- endmacro -%}

{#- Square tile for grids (events/releases). `item` is a collection item. -#}
{%- macro tile(item, kind="event") -%}
{%- set d = item.data -%}
{%- set img = d.cover or d.poster -%}
<li class="tile tile--{{ kind }}{% if d.status and d.status != 'released' %} tile--pending{% endif %}">
  <a href="{{ item.url }}">
    <span class="tile__img">
      {%- if img %}
      {% image img | bundle(item.inputPath), "", "(min-width: 60rem) 14rem, 45vw" %}
      {%- else %}
      <span class="gen-cover" aria-hidden="true">{{ (d.codename or d.title) | codename | wbr | safe }}</span>
      {%- endif %}
    </span>
    <span class="tile__title">{{ d.title }}</span>
    <span class="tile__meta">
      {%- if kind == "event" %}{{ d.date | date }} · {{ d.venue.city }}
      {%- else %}{% if d.catalog %}{{ d.catalog }} · {% endif %}{% t site.releaseTypes[d.type].en, site.releaseTypes[d.type].tr %}{% if d.status == "open-call" %} · <span class="ok">{% t "open call", "açık çağrı" %}</span>{% elif d.status != "released" %} · {{ d.status }}{% endif %}{% endif -%}
    </span>
  </a>
</li>
{%- endmacro -%}

{#- One line of the event log: 0x07 · 05.09.24 · Title // codename · category -#}
{%- macro logrow(e) -%}
<li class="log__row">
  <span class="log__id">{{ e.data.seq | hex }}</span>
  <time datetime="{{ e.data.date | date('iso') }}">{{ e.data.date | date('short') }}</time>
  <a href="{{ e.url }}">{{ e.data.title }}{% if e.data.codename %} <span class="log__code">// {{ e.data.codename | codename | lower }}</span>{% endif %}</a>
  <span class="log__tag">{{ e.data.category | asList | join("/") }}</span>
</li>
{%- endmacro -%}

{#- SoundCloud / Bandcamp players. `list` comes from the `players` filter. Nothing loads from those sites until a click. -#}
{%- macro players(list, en="LISTEN", tr="DİNLE", id="listen") -%}
{%- if list and list.length -%}
<section class="listen" aria-labelledby="{{ id }}">
  {{ sect(en, tr, "", id) }}
  <ul class="players">
    {%- for p in list %}
    <li class="player player--{{ p.type }}">
      <a class="embed-facade player__facade" href="{{ p.url }}" data-embed="{{ p.embed }}" data-height="{{ p.height }}" data-title="{{ p.label }}" rel="noopener noreferrer">
        <span class="player__play" aria-hidden="true">▶</span>
        <span class="player__body">
          <span class="player__label">{{ p.label }}</span>
          <span class="player__src">{{ p.type }} · {% t "click to load the player", "oynatıcıyı yüklemek için tıkla" %}</span>
        </span>
      </a>
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif -%}
{%- endmacro -%}

{#- PeerTube videos (`videos: [{url, title}]`), click-to-load: nothing loads from PeerTube until a click. -#}
{%- macro videos(list, cover, inputPath, title) -%}
{%- set vids = [] -%}
{%- for v in list or [] %}{% set p = v.url | peertube(site.peertube.host) %}{% if p %}{% if vids.push({ p: p, title: v.title or title }) %}{% endif %}{% endif %}{% endfor -%}
{%- if vids.length -%}
<section aria-labelledby="videos">
  {{ sect("VIDEO", "VİDEO", "", "videos") }}
  {%- for v in vids %}
  <figure class="video">
    <a class="embed-facade video__facade" href="{{ v.p.watch }}" data-embed="{{ v.p.embed }}" data-title="{{ v.title }}" data-sandbox="allow-same-origin allow-scripts allow-popups allow-forms" rel="noopener noreferrer">
      {%- if cover %}{% image cover | bundle(inputPath), "", "(min-width: 60rem) 46rem, 100vw" %}{% endif %}
      <span class="video__play"><span aria-hidden="true">▶</span> {% t "load video", "videoyu yükle" %}</span>
      <span class="video__note">{% t "peertube loads only after you click", "peertube yalnızca tıkladığında yüklenir" %}</span>
    </a>
    {%- if v.title %}<figcaption class="video__title">{{ v.title }}</figcaption>{% endif %}
  </figure>
  {%- endfor %}
</section>
{%- endif -%}
{%- endmacro -%}
