---
layout: base.njk
---
{%- import "macros.njk" as ui with context -%}
{%- set gs = collections.genres | genresOf(name) -%}
{%- set evs = collections.events | withSupergenre(collections.genres, name) | reverse -%}
{%- set arts = collections.artists | withSupergenre(collections.genres, name) -%}
{%- set rels = collections.releases | withSupergenre(collections.genres, name) -%}
<article class="wrap text-page sound">
  <header class="text-page__head">
    <p class="kline"><a href="/sound/">{% t "sound", "ses" %}</a> · {% t "supergenre", "üst tür" %} · {{ code }}</p>
    <h1 class="text-page__title"><span class="code code--big" aria-hidden="true">{{ code }}</span> {{ name }}</h1>
  </header>

  {%- if description_en or description_tr %}{{ ui.bitext(description_en, description_tr) }}{% endif %}

  {%- if gs.length %}
  <section aria-labelledby="s-genres">
    {{ ui.sect("GENRES", "TÜRLER", gs.length, "s-genres") }}
    <ul class="names">{% for g in gs %}<li><a href="{{ g.url }}">{{ g.data.name }}</a></li>{% endfor %}</ul>
  </section>
  {%- endif %}

  {%- if evs.length %}
  <section aria-labelledby="s-events">
    {{ ui.sect("EVENTS", "ETKİNLİKLER", evs.length, "s-events") }}
    <ol class="log">{% for e in evs %}{{ ui.logrow(e) }}{% endfor %}</ol>
  </section>
  {%- endif %}

  {%- if arts.length %}
  <section aria-labelledby="s-artists">
    {{ ui.sect("ARTISTS", "SANATÇILAR", arts.length, "s-artists") }}
    <ul class="names">{% for a in arts %}<li><a href="{{ a.url }}">{{ a.data.name }}</a></li>{% endfor %}</ul>
  </section>
  {%- endif %}

  {%- if rels.length %}
  <section aria-labelledby="s-releases">
    {{ ui.sect("RELEASES", "YAYINLAR", rels.length, "s-releases") }}
    <ul class="tiles">{% for r in rels %}{{ ui.tile(r, "release") }}{% endfor %}</ul>
  </section>
  {%- endif %}

  <nav class="pager" aria-label="Supergenres">
    <span></span>
    <a href="/sound/" class="pager__all">{% t "all supergenres", "tüm üst türler" %}</a>
    <span></span>
  </nav>
</article>
