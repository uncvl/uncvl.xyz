---
layout: base.njk
bodyClass: page-event signal
ogType: article
---
{%- import "macros.njk" as ui with context -%}
{%- set all = collections.events -%}
{%- set nb = all | neighbors(page.url) -%}
{%- set idx = nb.index -%}{%- set seq = idx + 1 -%}{%- set prev = nb.prev -%}{%- set next = nb.next -%}
{%- set upcoming = collections.upcomingEvents | findBySlug(slug) -%}

<article class="event" itemscope>
  <header class="hero">
    <div class="wrap hero__grid">
      <figure class="hero__poster">
        {%- if poster %}
        <a href="{{ poster | bundle(page.inputPath) | mediaFull }}" aria-label="full size poster">
          {% image poster | bundle(page.inputPath), poster_alt or title, "(min-width: 60rem) 22rem, (min-width: 40rem) 40vw, 100vw", true %}
        </a>
        {%- else %}
        <span class="gen-cover gen-cover--tall" aria-hidden="true">{{ (codename or title) | codename | wbr | safe }}</span>
        {%- endif %}
        {%- if poster_credit %}<figcaption class="hero__credit">{{ poster_credit | md | safe }}</figcaption>{% endif %}
      </figure>
      <div class="hero__meta">
        <p class="kline"><a href="/events/">{% t "events", "etkinlik" %}</a> · evt {{ seq | hex }} · {{ category | asList | join("/") }}{% if series %} · {{ series | lower }}{% endif %}{% if flavor and flavor.length %} · {{ ui.flavor(flavor) }}{% endif %}{% if upcoming %} · <span class="ok">{% t "upcoming", "yaklaşan" %}</span>{% endif %}</p>
        {%- if codename %}<p class="glitch" aria-hidden="true">{{ codename | codename | wbr | safe }}</p>{% endif %}
        <h1 class="hero__title">{{ title }}</h1>
        <dl class="facts">
          {%- if activities and activities.length %}<dt>{% t "content", "içerik" %}</dt><dd>{% for a in activities %}{% t a, a | vocabTr(vocab.activities) %}{% if not loop.last %}, {% endif %}{% endfor %}</dd>{% endif %}
          <dt>{% t "date", "tarih" %}</dt>
          <dd><time datetime="{{ date | date('iso') }}"><span class="l-en" lang="en">{{ date | date('long-en') }}</span><span class="l-tr" lang="tr">{{ date | date('long-tr') }}</span></time></dd>
          <dt>{% t "venue", "mekan" %}</dt><dd>{{ venue.name }}, {{ venue.city }}</dd>
          {%- if doors %}<dt>{% t "doors", "kapı" %}</dt><dd>{{ doors }}</dd>{% endif %}
          {%- if stage %}<dt>{% t "stage", "sahne" %}</dt><dd>{{ stage }}</dd>{% endif %}
          {%- if price %}<dt>{% t "ticket", "bilet" %}</dt><dd class="ok">{{ price }}</dd>{% endif %}
          {%- if resident_advisor %}<dt>ra</dt><dd><a href="{{ resident_advisor }}" rel="noopener noreferrer">Resident Advisor ↗</a></dd>{% endif %}
          {%- if music_genres and music_genres.length %}<dt>{% t "genres", "türler" %}</dt><dd>{{ ui.genreLinks(music_genres) }}</dd>{% endif %}
        </dl>
      </div>
    </div>
  </header>

  <div class="wrap event__body">
    {%- if lineup and lineup.length %}
    <section aria-labelledby="lineup">
      {{ ui.sect("LINEUP", "KADRO", ("peers connected: " + lineup.length), "lineup") }}
      <ul class="peers">
        {%- for l in lineup %}
        {%- set artistPage = collections.artists | findBySlug(l.artist) if l.artist else null %}
        <li class="peer">
          {%- if artistPage %}<a class="peer__name" lang="zxx" href="{{ artistPage.url }}">{{ l.name }}</a>{% else %}<span class="peer__name" lang="zxx">{{ l.name }}</span>{% endif %}
          {%- set acts = l.act_type | asList %}
          {%- if l.duration or acts.length %}<span class="peer__meta">{{ l.duration }}{% if l.duration and acts.length %} · {% endif %}{% for a in acts %}{% t a, a | vocabTr(vocab.act_types) %}{% if not loop.last %} · {% endif %}{% endfor %}</span>{% endif %}
          {%- if l.note_en or l.note_tr %}<span class="peer__note"><span class="l-en" lang="en">{{ l.note_en or l.note_tr }}</span><span class="l-tr" lang="tr">{{ l.note_tr or l.note_en }}</span></span>{% endif %}
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- endif %}

    {{ ui.names(exhibition, "EXHIBITION", "SERGİ", "exhibition") }}
    {{ ui.names(art_market, "ART MARKET", "SANAT PAZARI", "art-market") }}

    {%- if schedule and schedule.length %}
    <section aria-labelledby="schedule">
      {{ ui.sect("SCHEDULE", "AKIŞ", "", "schedule") }}
      <ol class="schedule">
        {%- for s in schedule %}
        <li><time>{{ s.time }}</time> <span class="l-en" lang="en">{{ s.en }}</span><span class="l-tr" lang="tr">{{ s.tr or s.en }}</span></li>
        {%- endfor %}
      </ol>
    </section>
    {%- endif %}

    {%- if text_en or text_tr %}
    <section aria-labelledby="info">
      {{ ui.sect("EVENT INFO", "ETKİNLİK METNİ", "", "info") }}
      {{ ui.bitext(text_en, text_tr) }}
    </section>
    {%- endif %}

    {%- set promoTube = promo | peertube(site.peertube.host) if promo else null %}
    {%- set promoUrl = (promo | bundle(page.inputPath) | mediaVideo) if (promo and not promoTube) else null %}
    {%- if promoTube %}
    {{ ui.videos([{ url: promo }], cover or poster, page.inputPath, title, "PROMO VIDEO", "TANITIM VİDEOSU", "promo") }}
    {%- elif promoUrl %}
    <section aria-labelledby="promo">
      {{ ui.sect("PROMO VIDEO", "TANITIM VİDEOSU", "", "promo") }}
      <video class="promo" controls preload="none" playsinline src="{{ promoUrl }}"{% if poster %} poster="{{ poster | bundle(page.inputPath) | mediaOg }}"{% endif %}></video>
    </section>
    {%- endif %}
    {{ ui.players({ listen: recordings } | players, "SOUND RECORDINGS", "SES KAYITLARI", "recordings") }}
    {{ ui.players({ listen: listen, links: links, bandcamp_id: bandcamp_id, title: title, name: name } | players) }}
    {%- if tickets_en or tickets_tr %}
    <section class="tickets" aria-labelledby="tickets">
      {{ ui.sect("TICKETS", "BİLET", "", "tickets") }}
      {{ ui.bitext(tickets_en, tickets_tr) }}
    </section>
    {%- endif %}

    {%- set bios = [] %}{% for l in lineup %}{% if l.bio_en or l.bio_tr %}{% if bios.push(l) %}{% endif %}{% endif %}{% endfor %}
    {%- if bios.length %}
    <section aria-labelledby="bios">
      {{ ui.sect("PERFORMER INFO", "SANATÇI BİLGİLERİ", "", "bios") }}
      {%- for l in bios %}
      <div class="bio">
        <h3 class="bio__name">{{ l.name | upper }}</h3>
        {{ ui.bitext(l.bio_en, l.bio_tr) }}
      </div>
      {%- endfor %}
    </section>
    {%- endif %}

    {{ ui.videos(after_videos, cover or poster, page.inputPath, title, "AFTER VIDEO", "AFTER VİDEO", "after-videos") }}

    {%- if gallery and gallery.length %}
    <section aria-labelledby="gallery">
      {{ ui.sect("GALLERY", "GALERİ", "", "gallery") }}
      <div class="gallery">
        {%- for g in gallery %}
        <a href="{{ g.src | bundle(page.inputPath) | mediaFull }}"{% if g.wide %} class="gallery__wide"{% endif %}>{% image g.src | bundle(page.inputPath), g.alt, ("(min-width: 60rem) 56rem, 100vw" if g.wide else "(min-width: 60rem) 18rem, 50vw") %}</a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    {%- if notes_en or notes_tr %}
    <section aria-labelledby="notes">
      {{ ui.sect("NOTES", "NOTLAR", "", "notes") }}
      {{ ui.bitext(notes_en, notes_tr) }}
    </section>
    {%- endif %}

    <nav class="pager" aria-label="Events">
      {%- if prev %}<a rel="prev" href="{{ prev.url }}"><span class="k">&lt; prev {{ (idx) | hex }}</span>{{ prev.data.title }}</a>{% else %}<span></span>{% endif %}
      <a href="/events/" class="pager__all">{% t "all events", "tüm etkinlikler" %}</a>
      {%- if next %}<a rel="next" href="{{ next.url }}"><span class="k">next {{ (idx + 2) | hex }} &gt;</span>{{ next.data.title }}</a>{% else %}<span></span>{% endif %}
    </nav>
  </div>
</article>

{#- schema.org MusicEvent -#}
{%- set ld = {
  "@context": "https://schema.org",
  "@type": "MusicEvent",
  "name": title,
  "startDate": (date | date('iso')) + (("T" + (stage if (stage and stage.length == 5) else "21:00") + ":00+03:00")),
  "eventStatus": "https://schema.org/EventScheduled",
  "location": { "@type": "Place", "name": venue.name, "address": venue.city },
  "organizer": { "@type": "Organization", "name": "Uncivilization", "url": site.url },
  "url": page.url | absoluteUrl(site.url)
} -%}
<script type="application/ld+json">{{ ld | json | safe }}</script>
