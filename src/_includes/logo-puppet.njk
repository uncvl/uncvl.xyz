{%- set part %}<rect fill="#000" width="762" height="931.333" mask="url(#{{ lid }}-guy)"{%- endset -%}
<svg class="logo logo--logomark logo--puppet" viewBox="0 0 762 931.333" fill="currentColor" aria-hidden="true" focusable="false"><defs>
<mask id="{{ lid }}-guy" maskUnits="userSpaceOnUse" x="0" y="0" width="762" height="931.333"><path fill="#fff" fill-rule="evenodd" d="{{ outline }}{{ pieces }}{{ disc }}{{ strings }}{{ strips }}"/></mask>
