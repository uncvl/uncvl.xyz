<clipPath id="{{ lid }}-body"><polygon points="0,372 330,377 334,376 428,376 432,377 762,372 762,650 530,650 522,600 484,600 493,639 269,639 278,600 240,600 232,650 0,650"/></clipPath>
<clipPath id="{{ lid }}-leg-l"><polygon points="267,631 383,631 383,931.333 205,931.333"/></clipPath>
<clipPath id="{{ lid }}-leg-r"><polygon points="379,631 495,631 557,931.333 379,931.333"/></clipPath>
<mask id="{{ lid }}-cut" maskUnits="userSpaceOnUse" x="-200" y="-200" width="1162" height="1331.333"><rect fill="#fff" x="-200" y="-200" width="1162" height="1331.333"/><path fill="#000" d="{{ strings }}"/>
<g data-part="body">{{ part | safe }} clip-path="url(#{{ lid }}-body)"/>
<g data-part="head">{{ part | safe }} clip-path="url(#{{ lid }}-head)"/></g>
<g data-part="leg-l">{{ part | safe }} clip-path="url(#{{ lid }}-leg-l)"/></g>
<g data-part="leg-r">{{ part | safe }} clip-path="url(#{{ lid }}-leg-r)"/></g>
</g></mask></defs><path d="{{ outline }}" mask="url(#{{ lid }}-cut)"/></svg>
