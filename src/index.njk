---
layout: base.njk
bodyClass: page-home
permalink: /
---
{%- import "macros.njk" as ui with context -%}
<section class="home-hero">
  <div class="wrap home-hero__grid">
    <div class="comet comet--big" aria-hidden="true">
      <span class="comet__tail"></span>
      {% include "brand/logomark.svg" %}
    </div>
    <div class="home-hero__text">
      <p class="k">$ whoami</p>
      {{ ui.bitext(home.intro_en, home.intro_tr, "prose prose--lead") }}
      <ul class="notes">
        {#- notes: short, so a missing translation silently falls back to the other language -#}
        {%- for n in home.notes %}
        {%- set tEn = n.text_en or n.text_tr %}{% set tTr = n.text_tr or n.text_en %}
        {%- set mEn = n.more_en or n.more_tr %}{% set mTr = n.more_tr or n.more_en %}
        <li class="note">
          <div class="note__text"><div class="l-en" lang="en">{{ tEn | md | safe }}</div><div class="l-tr" lang="tr">{{ tTr | md | safe }}</div></div>
          {%- if mEn %}<div class="note__more"><div class="l-en" lang="en">{{ mEn | md | safe }}</div><div class="l-tr" lang="tr">{{ mTr | md | safe }}</div></div>{% endif %}
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<div class="wrap">
  <section aria-labelledby="upcoming">
    {{ ui.sect("UPCOMING EVENTS", "YAKLAŞAN ETKİNLİKLER", "", "upcoming") }}
    {%- set up = collections.upcomingEvents %}
    {%- if up.length %}
    <ul class="upcoming">
      {%- for e in up %}
      <li class="upcoming__item">
        <a class="upcoming__poster" href="{{ e.url }}" tabindex="-1" aria-hidden="true">
          {%- if e.data.poster %}{% image e.data.poster | bundle(e.inputPath), "", "(min-width: 40rem) 12rem, 35vw" %}{% else %}<span class="gen-cover gen-cover--tall">{{ (e.data.codename or e.data.title) | codename | wbr | safe }}</span>{% endif %}
        </a>
        <div>
          <p class="kline">{% if e.data.flavor and e.data.flavor.length %}{{ ui.flavor(e.data.flavor) }}{% else %}{{ ui.genres(e.data.music_genres) }}{% endif %}{% if e.data.codename %} · <span class="ok">codename: {{ e.data.codename | codename | lower | wbr | safe }}</span>{% endif %}</p>
          <h3 class="upcoming__title"><a href="{{ e.url }}">{{ e.data.title }}</a></h3>
          <p>{{ e.data.date | date }} · {{ e.data.venue.name }}, {{ e.data.venue.city }}</p>
          {%- if e.data.lineup %}<p class="lineup-strip">{% for l in e.data.lineup %}{{ l.name | upper }}{% if not loop.last %} / {% endif %}{% endfor %}</p>{% endif %}
          <p><a href="{{ e.url }}">&gt; {% t "details", "detaylar" %}</a></p>
        </div>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="empty"><span class="k">&gt; poll(upcoming)</span> <span class="l-en" lang="en">no transmission scheduled yet. stay tuned.</span><span class="l-tr" lang="tr">henüz planlanmış bir yayın yok. takipte kalın.</span><span class="cursor" aria-hidden="true">_</span></p>
    {%- endif %}
  </section>

  <section aria-labelledby="releases">
    {{ ui.sect("RELEASES", "YAYINLAR", "label · bandcamp · soundcloud", "releases") }}
    <ul class="tiles">
      {%- for r in collections.releases | limit(8) %}{{ ui.tile(r, "release") }}{% endfor %}
    </ul>
  </section>

  {%- if collections.openCalls.length %}
  <section aria-labelledby="calls">
    {{ ui.sect("CALLS", "ÇAĞRILAR", '<a href="/calls/">all calls</a>', "calls") }}
    {%- for c in collections.openCalls %}
    {%- set d = c.data %}
    {%- set hEn = d.box_head_en or d.box_head_tr or d.title_en %}{% set hTr = d.box_head_tr or hEn %}
    {%- set bEn = d.box_body_en or d.box_body_tr %}{% set bTr = d.box_body_tr or bEn %}
    <div class="call">
      <p class="call__head"><span class="l-en" lang="en">{{ hEn | mdInline | safe }}</span><span class="l-tr" lang="tr">{{ hTr | mdInline | safe }}</span></p>
      {%- if bEn %}
      <hr>
      <div class="prose l-en" lang="en">{{ bEn | md | safe }}</div>
      <div class="prose l-tr" lang="tr">{{ bTr | md | safe }}</div>
      {%- endif %}
      <p><a href="{{ c.url }}">{% t "Detailed information is here.", "Detaylı bilgi burada." %}</a></p>
    </div>
    {%- endfor %}
  </section>
  {%- endif %}

  {%- if collections.posts.length %}
  <section aria-labelledby="posts">
    {{ ui.sect("POSTS", "YAZILAR", "", "posts") }}
    <ol class="log">
      {%- for p in collections.posts | limit(5) %}
      <li class="log__row"><span class="log__id">{{ (collections.posts.length - loop.index0) | hex }}</span><time datetime="{{ p.data.date | date('iso') }}">{{ p.data.date | date('short') }}</time><a href="{{ p.url }}">{{ p.data.title }}</a><span class="log__tag">post</span></li>
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}

  <section aria-labelledby="past">
    {%- set chips = [] %}{% for key, c in site.categories %}{% if chips.push('<a href="/events/#' + key + '">' + (c.en | lower) + '</a>') %}{% endif %}{% endfor %}
    {{ ui.sect("PAST EVENTS", "GEÇMİŞ ETKİNLİKLER", chips | join(" · "), "past") }}
    <ol class="log">
      {%- for e in collections.pastEvents %}{{ ui.logrow(e) }}{% endfor %}
    </ol>
  </section>
</div>
