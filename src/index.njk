---
layout: base.njk
bodyClass: page-home
permalink: /
---
{%- import "macros.njk" as ui with context -%}
<section class="home-hero">
  <div class="wrap home-hero__grid">
    <div class="comet comet--big" aria-hidden="true">
      <span class="comet__tail"></span>
      {% include "brand/logomark.svg" %}
    </div>
    <div class="home-hero__text">
      <p class="k">$ whoami</p>
      {{ ui.bitext(home.intro_en, home.intro_tr, "prose prose--lead") }}
      <ul class="notes">
        {%- for n in home.notes %}
        <li class="note">
          <div class="note__text">{{ n.text | md | safe }}</div>
          <div class="note__more">{{ n.more | md | safe }}</div>
        </li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<div class="wrap">
  <section aria-labelledby="upcoming">
    {{ ui.sect("UPCOMING EVENTS", "YAKLAŞAN ETKİNLİKLER", "", "upcoming") }}
    {%- set up = collections.upcomingEvents %}
    {%- if up.length %}
    <ul class="upcoming">
      {%- for e in up %}
      <li class="upcoming__item">
        <a class="upcoming__poster" href="{{ e.url }}" tabindex="-1" aria-hidden="true">
          {%- if e.data.poster %}{% image e.data.poster | bundle(e.inputPath), "", "(min-width: 40rem) 12rem, 35vw" %}{% else %}<span class="gen-cover gen-cover--tall">{{ (e.data.codename or e.data.title) | codename | wbr | safe }}</span>{% endif %}
        </a>
        <div>
          <p class="kline">{{ ui.genres(e.data.genres) }}{% if e.data.codename %} · <span class="ok">codename: {{ e.data.codename | codename | lower }}</span>{% endif %}</p>
          <h3 class="upcoming__title"><a href="{{ e.url }}">{{ e.data.title }}</a></h3>
          <p>{{ e.data.date | date }} · {{ e.data.venue.name }}, {{ e.data.venue.city }}</p>
          {%- if e.data.lineup %}<p class="lineup-strip">{% for l in e.data.lineup %}{{ l.name | upper }}{% if not loop.last %} / {% endif %}{% endfor %}</p>{% endif %}
          <p><a href="{{ e.url }}">&gt; {% t "details", "detaylar" %}</a></p>
        </div>
      </li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="empty"><span class="k">&gt; poll(upcoming)</span> <span class="l-en" lang="en">no transmission scheduled yet. stay tuned.</span><span class="l-tr" lang="tr">henüz planlanmış bir yayın yok. takipte kalın.</span><span class="cursor" aria-hidden="true">_</span></p>
    {%- endif %}
  </section>

  <section aria-labelledby="releases">
    {{ ui.sect("RELEASES", "YAYINLAR", "label · bandcamp · soundcloud", "releases") }}
    <ul class="tiles">
      {%- for r in collections.releases | limit(8) %}{{ ui.tile(r, "release") }}{% endfor %}
    </ul>
  </section>

  <section class="call" aria-labelledby="call">
    <h2 id="call" class="call__head">{{ home.call.head | mdInline | safe }}</h2>
    <hr>
    <div class="prose">{{ home.call.body | md | safe }}</div>
    <p><a href="/compilation/">{{ home.call.link }}</a></p>
  </section>

  {%- if collections.posts.length %}
  <section aria-labelledby="posts">
    {{ ui.sect("POSTS", "YAZILAR", "", "posts") }}
    <ol class="log">
      {%- for p in collections.posts | limit(5) %}
      <li class="log__row"><span class="log__id">{{ (collections.posts.length - loop.index0) | hex }}</span><time datetime="{{ p.data.date | date('iso') }}">{{ p.data.date | date('short') }}</time><a href="{{ p.url }}">{{ p.data.title }}</a><span class="log__tag">post</span></li>
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}

  <section aria-labelledby="past">
    {{ ui.sect("PAST EVENTS", "GEÇMİŞ ETKİNLİKLER", '<a href="/events/#art">art</a> · <a href="/events/#break">break</a> · <a href="/events/#bass">bass</a> · <a href="/events/#punk">punk</a>', "past") }}
    <ol class="log">
      {%- for e in collections.pastEvents %}{{ ui.logrow(e) }}{% endfor %}
    </ol>
  </section>
</div>
