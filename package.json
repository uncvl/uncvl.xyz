{
  "name": "uncvl.xyz",
  "version": "0.1.0",
  "private": true,
  "description": "Static website for Uncivilization (uncvl.xyz)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "brand": "node scripts/brand.mjs",
    "build": "npm run brand && npm run vendor && eleventy",
    "serve": "npm run brand && npm run vendor && eleventy --serve --port=8080",
    "clean": "node -e \"fs.rmSync('_site',{recursive:true,force:true})\"",
    "check": "node scripts/check.mjs",
    "strip-metadata": "node scripts/strip-metadata.mjs",
    "r2:media": "node scripts/r2-upload.mjs media",
    "r2:archive": "node scripts/r2-upload.mjs archive",
    "r2:file": "node scripts/r2-upload.mjs file",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@11ty/eleventy-img": "7.1.1",
    "@11ty/eleventy-plugin-rss": "3.1.0",
    "@fontsource/inconsolata": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@sveltia/cms": "0.264.0",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.3",
    "svgo": "4.1.0"
  },
  "dependencies": {
    "@chenglou/pretext": "1.0.0",
    "trystero": "0.27.0"
  }
}
