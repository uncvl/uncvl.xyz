// Cloudflare Worker for uncvl.xyz. Deployed by CI with `wrangler deploy` (.forgejo/workflows/deploy.yml).
//
// - The built site (_site) is served as static assets. Asset requests never run the Worker code,
//   so pages stay free and unlimited. _site/_headers and _site/_redirects are honoured.
// - Only /api/* runs worker/index.js: the CMS media endpoint (uploads to R2, Codeberg login).
{
  "name": "uncvl",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "uncvl-media" }],
  // The custom domain uncvl.xyz is attached in the Cloudflare dashboard. It is deliberately NOT listed here:
  // without "routes", wrangler never touches routes/domains, so the deploy token needs no zone permissions.
  // No *.workers.dev address and no preview URLs: the site is only reachable on uncvl.xyz.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
