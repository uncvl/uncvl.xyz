# Security + caching headers (Cloudflare Workers static assets, Netlify-style _headers syntax)
# static.cloudflareinsights.com / cloudflareinsights.com: Cloudflare Web Analytics (cookieless) beacon.
# Cloudflare's bot-detection inline snippet stays blocked on purpose (it would need unsafe-inline).
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://media.uncvl.xyz; media-src 'self' https://media.uncvl.xyz; font-src 'self'; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; frame-src https://v.basspistol.org https://bandcamp.com https://w.soundcloud.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# The CMS needs the GitHub API, its lazily loaded helpers and inline styles.
# COOP must not be same-origin here: the "Sign in with Codeberg" popup goes cross-origin, and
# with same-origin the CMS loses its handle on the popup ("Authentication aborted").
/admin/*
  ! Cross-Origin-Opener-Policy
  Cross-Origin-Opener-Policy: unsafe-none
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; manifest-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' data: blob: https://api.github.com https://unpkg.com https://cdn.jsdelivr.net https://media.uncvl.xyz https://cloudflareinsights.com; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  Cache-Control: no-cache

# /chat/: browsers find each other through these Nostr relays (keep in sync with RELAYS in
# src/assets/js/chat.js); the messages themselves go browser to browser over WebRTC, which CSP doesn't cover.
/chat/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://media.uncvl.xyz; media-src 'self' https://media.uncvl.xyz; font-src 'self'; style-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com wss://relay.nostr.net wss://relay.snort.social wss://relay.primal.net wss://nostr.data.haus; frame-src https://v.basspistol.org https://bandcamp.com https://w.soundcloud.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Sitemap and feed: plain XML with no scripts or styles, so the page CSP adds nothing, and it stops
# browsers' built-in XML viewer from formatting them (it uses inline styles). Search engines and feed
# readers ignore CSP either way.
/sitemap.xml
  ! Content-Security-Policy
/feed.xml
  ! Content-Security-Policy

/img/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  # URLs carry ?v=<content hash>, so they can be cached for a long time
  Cache-Control: public, max-age=31536000, immutable
